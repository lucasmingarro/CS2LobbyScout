{
  "name": "cs2-lobby-scout",
  "version": "0.1.2",
  "description": "External CS2 lobby scouting tool: aggregates public Steam and FACEIT data for the players in your current match.",
  "main": "./out/main/index.js",
  "author": "Lucas Mingarro",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/test.mjs run",
    "test:watch": "node scripts/test.mjs",
    "build:win": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "build:unpack": "electron-vite build && electron-builder --dir --config electron-builder.yml",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
